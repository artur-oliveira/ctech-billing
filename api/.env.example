# ctech-billing-api environment variables
# Copy to .env for local development. NEVER commit real secrets.

# Server
PORT=8004
ENVIRONMENT=dev

# AWS
AWS_REGION=us-east-1
# Required, with no default on purpose: a service that falls back to a shared
# prefix writes production rows from a dev machine.
# Company standard: {env}_billing_{table}, so the prefix carries the first two
# segments and the physical table is dev_billing_main.
TABLE_PREFIX=dev_billing

# Tenant zero: the organization whose customers the portal serves (ADR 0012).
# Empty disables the portal — its routes answer 404 rather than falling back to
# some other organization.
PORTAL_ORGANIZATION_ID=

# For local DynamoDB (docker-compose.test.yml)
# DYNAMODB_ENDPOINT=http://localhost:8124

# Auth — RS256 JWKS from ctech-account
CTECH_ISSUER_URL=https://accounts-api.aoctech.app
CTECH_JWKS_URL=https://accounts-api.aoctech.app/.well-known/jwks.json
# The `aud` this service accepts. A token minted for another CTech service must
# not be usable here.
SERVICE_AUDIENCE=https://billing.aoctech.app

# JWKS cache. Absent means a per-instance in-memory cache, which is correct for
# one instance and merely wasteful for several.
# VALKEY_URL=redis://localhost:6379
